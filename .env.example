# Copy this to .env and fill in your keys

# Indian Kanoon official API token
# Get from: api.indiankanoon.org → Generate Token
INDIAN_KANOON_API_TOKEN=paste_your_ik_token_here

# OpenRouter API key (free account works)
# Get from: openrouter.ai → API Keys
OPENROUTER_API_KEY=paste_your_openrouter_key_here

# Council model slots — all default to free SOTA models
# Swap to better models by changing these values
COUNCIL_EXTRACTOR_MODEL=nvidia/nemotron-3-super-120b-a12b:free
COUNCIL_SKEPTIC_MODEL=tencent/hy3-preview:free
COUNCIL_ADVERSARY_MODEL=deepseek/deepseek-chat-v3.1:free
COUNCIL_OUTSIDER_MODEL=inclusionai/ling-2.6-1t:free
COUNCIL_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
SYNTHESIS_MODEL=inclusionai/ling-2.6-1t:free
