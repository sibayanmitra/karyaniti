# Copy this file to .env and fill in your own keys. Never commit .env.

# Indian Kanoon API token (api.indiankanoon.org)
INDIAN_KANOON_API_TOKEN=paste_your_ik_token_here

# OpenRouter API key (openrouter.ai)
OPENROUTER_API_KEY=paste_your_openrouter_key_here

# Model for each pipeline role (any OpenRouter model id)
COUNCIL_EXTRACTOR_MODEL=
COUNCIL_ADVERSARY_MODEL=
COUNCIL_JUDGE_MODEL=
SYNTHESIS_MODEL=
RERANK_MODEL=
COUNCIL_EXPANSION_MODEL=anthropic/claude-opus-4.7
COUNCIL_FAITHFUL_MODEL=deepseek/deepseek-v4-pro
COUNCIL_ATTRIBUTION_MODEL=deepseek/deepseek-v4-pro

# Optional: cap on queries per day when sharing the server
KARYANITI_DAILY_CAP=25
